# ──────────────────────────────────────────────
# AI Model API Keys
# ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...                          # GPT-4o for code generation + consensus oracle
ANTHROPIC_API_KEY=sk-ant-...                   # Claude for consensus oracle + fallback generation
GEMINI_API_KEY=AI...                           # Gemini for consensus oracle

# ──────────────────────────────────────────────
# Blockchain
# ──────────────────────────────────────────────
PRIVATE_KEY=0x...                              # Deployer/server wallet private key (Base Sepolia)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org  # Base Sepolia RPC endpoint
ETHERSCAN_API_KEY=...                          # For contract verification on Basescan

# Contract addresses (populated after deployment)
REGISTRY_CONTRACT_ADDRESS=0x...
CONSUMER_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_REGISTRY_ADDRESS=0x...            # Same as REGISTRY_CONTRACT_ADDRESS (exposed to frontend)

# ──────────────────────────────────────────────
# x402 Payment
# ──────────────────────────────────────────────
WALLET_ADDRESS=0x...                           # Address to receive x402 payments
X402_FACILITATOR_URL=https://x402.org/facilitator

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
DATABASE_PATH=./data/ciel.db
CRE_CLI_PATH=cre                               # Path to CRE CLI binary
NODE_ENV=development

# ──────────────────────────────────────────────
# Tenderly Virtual TestNets
# ──────────────────────────────────────────────
TENDERLY_ACCESS_KEY=                           # From dashboard.tenderly.co > Settings > Authorization
TENDERLY_ACCOUNT_SLUG=me                       # Account slug (default: "me" for personal)
TENDERLY_PROJECT_SLUG=ciel                     # Project slug from dashboard URL
TENDERLY_VIRTUAL_TESTNET_RPC=                  # Optional: static RPC URL for pre-existing VNet
